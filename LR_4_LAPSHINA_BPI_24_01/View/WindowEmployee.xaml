<Window x:Class="LR_4_LAPSHINA_BPI_24_01.View.WindowEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники" Height="350" Width="600">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Background="#FFE4E9E0">
            <Button Content="Добавить" Height="25" Margin="10,10,5,10" Command="{Binding AddPerson}"/>
            <Button Content="Редактировать" Height="25" Margin="10,10,5,10" Command="{Binding EditPerson}"/>
            <Button Content="Удалить" Height="25" Margin="10,10,5,10" Command="{Binding DeletePerson}"/>
        </StackPanel>
        <ListView ItemsSource="{Binding ListPersonDpo}" SelectedItem="{Binding SelectedPersonDpo}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Фамилия" Width="100" DisplayMemberBinding="{Binding LastName}"/>
                    <GridViewColumn Header="Имя" Width="100" DisplayMemberBinding="{Binding FirstName}"/>
                    <GridViewColumn Header="Должность" Width="100" DisplayMemberBinding="{Binding RoleName}"/>
                    <GridViewColumn Header="Дата рождения" Width="100" DisplayMemberBinding="{Binding Birthday, StringFormat={}{0:dd.MM.yyyy}}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>