<Window x:Class="LR_4_LAPSHINA_BPI_24_01.View.WindowNewEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="300" Width="300" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Код:" Grid.Row="0" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Id}" Grid.Row="0" Grid.Column="1" Margin="0,5,0,5" IsReadOnly="True"/>

        <TextBlock Text="Должность:" Grid.Row="1" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox x:Name="CbRole" Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" DisplayMemberPath="NameRole" SelectedValuePath="Id"/>

        <TextBlock Text="Фамилия:" Grid.Row="2" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5,0,5"/>

        <TextBlock Text="Имя:" Grid.Row="3" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="0,5,0,5"/>

        <TextBlock Text="Дата рождения:" Grid.Row="4" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <DatePicker SelectedDate="{Binding Birthday}" Grid.Row="4" Grid.Column="1" Margin="0,5,0,5"/>

        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Сохранить" Width="80" Height="25" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Content="Отменить" Width="80" Height="25" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>